effect READ_INPUT
effect WRITE_CALLER_OUTPUT
effect REPOSITORY_WRITE
effect CI_MUTATION
effect COMMIT
effect MERGE
effect RELEASE_MUTATION
capability semantic_planner READ_INPUT WRITE_CALLER_OUTPUT

precedence REFUTED>UNKNOWN>CLOSED
unknown_fields stage,step,reason,unknown_class,next_operation,blocked_by
forbidden_authority REPOSITORY_WRITE CI_MUTATION COMMIT MERGE RELEASE_MUTATION EXECUTE
conflict WRITE_WRITE
conflict WRITE_READ
conflict MUTABLE_AUTHORITY
conflict SINGLE_LEDGER_WRITER
conflict DEPENDENCY
fixed_point FIXED_POINT
proof FOUNDATION
proof COHERENCE
proof REGRESSION
indicator DRIVER
indicator OUTCOME
indicator GUARDRAIL
prohibition AGGREGATE_SCORE
prohibition PERCENTAGE
prohibition HEURISTIC_OPTIMIZATION
runtime_authority repository_writes=0 source_mutations=0 commit_authority=0 merge_authority=0 release_mutation=0 execution_authority=0 local_test_executions=0 local_format_executions=0

denominator id=semantic-work-wave-planner-v1 cell_count=10
