gooo semantic_work_wave_planner v1
namespace gooo://semantic-work-wave-planner/v1

# This source is the scheduling authority. Go parses it and projects the
# declared evidence; it has no operation, repository, commit, merge, or
# release mutation authority.
semantic_authority_id gooo://semantic-work-wave-planner/v1
repository_identity github.com/kimjooyoon/gooo-evolution-transaction-coordinator
read_set .gooo/semantic-work-wave-planner.gooo,contracts/semantic-work-wave-planner-v1.json,fixtures/semantic-work-wave-planner
